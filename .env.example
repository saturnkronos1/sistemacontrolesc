# ─── App ───
APP_NAME="Sistema Control Escolar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─── Logging ───
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───
# Development (SQLite - default)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Production (MySQL - descomentar para producción)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sistemacontrol
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Session ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Broadcasting ───
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ─── Cache ───
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ─── Redis (opcional, para producción) ───
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ─── Mail ───
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sistema-control.edu.mx"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS (opcional, para almacenamiento S3) ───
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Flux UI (requerido para instalar dependencias) ───
# FLUX_USERNAME=your-flux-username
# FLUX_LICENSE_KEY=your-flux-license-key

# ─── Laravel Cloud (opcional, para despliegue) ───
# LARAVEL_CLOUD_TOKEN=your-api-token
# LARAVEL_CLOUD_REPOSITORY=owner/repo
# LARAVEL_CLOUD_REGION=us-east-2

# ─── Vite ───
VITE_APP_NAME="${APP_NAME}"
